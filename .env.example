# ---------------------------------------------------------------------------
# Required on Railway
# ---------------------------------------------------------------------------
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
OPENROUTER_API_KEY=

# SEC blocks requests without a descriptive User-Agent containing an email.
# This is not optional -- you will get 403s.
SEC_USER_AGENT=Your Name your@email.com

# Postgres is required (all data lives here).
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Redis is OPTIONAL. Leave empty to use the in-process cache/rate-limiter, which
# is equivalent for a single service. Only set it if you run multiple processes
# that must share rate-limit budgets.
REDIS_URL=

# ---------------------------------------------------------------------------
# LLM. Verified against GET /api/v1/models at startup -- a bad string fails
# loudly with the available DeepSeek options rather than at Stage 4.
# ---------------------------------------------------------------------------
LLM_TRIAGE_MODEL=deepseek/deepseek-chat
LLM_DEEP_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.2
LLM_VERIFY_MODELS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Funnel widths
# ---------------------------------------------------------------------------
STAGE2_TAKE=400
STAGE3_TAKE=100
STAGE4_TAKE=25
STAGE5_TAKE=10
MAX_PER_SECTOR=3

# ---------------------------------------------------------------------------
# Universe filters
# ---------------------------------------------------------------------------
MIN_PRICE=3.0
MIN_DOLLAR_VOLUME=2000000
MIN_MARKET_CAP=150000000
# Abort the run rather than ship a report built on a broken universe.
MIN_UNIVERSE_SIZE=4000

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO

# Deprecated / unused. The /run and /backfill endpoints are open by design so
# the one-button site needs no token. You can leave this unset and delete it.
API_KEY=
RUN_TIMEZONE=America/New_York
RUN_HOUR=6
RUN_MINUTE=0

# Single-service mode: set true on the one Railway service so it runs the daily
# funnel cron inside the API process (no separate worker). Leave unset locally.
ENABLE_SCHEDULER=false
REPORT_DIR=/data/reports
MAX_RUN_COST_USD=2.0
HTTP_CONCURRENCY=10

# Business days added on top of filing_date to model ingestion lag.
PIT_LAG_BUSINESS_DAYS=2
