# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# By default the funnel runs on FREE data: the universe comes from SEC's company
# list and prices from the Stooq bulk daily archive -- no market-data keys required. Keys
# below are OPTIONAL upgrades; set any and the funnel uses it automatically.
#   POLYGON_API_KEY  faster whole-market bars + reference data
#   FMP_API_KEY      market caps + GICS sectors (sharpens sector-neutral scoring)
#   FINNHUB_API_KEY  estimates / earnings extras
#   FRED_API_KEY     macro regime tilt
POLYGON_API_KEY=
# Polygon plan: "free" (default) or "paid". This is selected by CAPABILITY, not
# key presence. On "free", Polygon is capped to 5 calls/min and is NEVER used for
# the multi-day bar backfill (that would 429 for hours) -- the wide end comes from
# the Stooq bulk archive instead. Set "paid" only if your key has the higher
# grouped-daily limits; then Polygon becomes an allowed backfill fallback behind
# the bulk sources. Leave unset (free) unless you know you pay for Polygon.
POLYGON_TIER=free
FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# Only needed for the Stage 4-5 LLM write-ups. Without it, run with skip_llm and
# you still get the ranked, deterministic top-10.
OPENROUTER_API_KEY=

# REQUIRED. SEC blocks requests without a descriptive User-Agent containing an
# email, and it's the free-data universe seed -- you will get 403s without it.
SEC_USER_AGENT=Your Name your@email.com

# Free-data mode only: cap how many tickers to keep from the Stooq bulk archive on the first
# backfill (0 = all ~10k; price/liquidity filters trim the illiquid ones anyway).
# Lower it (e.g. 3000) to make the very first history load faster.
FREE_UNIVERSE_MAX=0

# Postgres is required (all data lives here).
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Redis is OPTIONAL. Leave empty to use the in-process cache/rate-limiter, which
# is equivalent for a single service. Only set it if you run multiple processes
# that must share rate-limit budgets.
REDIS_URL=

# ---------------------------------------------------------------------------
# LLM. Verified against GET /api/v1/models at startup -- a bad string fails
# loudly with the available DeepSeek options rather than at Stage 4.
# ---------------------------------------------------------------------------
LLM_TRIAGE_MODEL=deepseek/deepseek-chat
LLM_DEEP_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.2
LLM_VERIFY_MODELS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Question box on /company/{ticker}.
#
# Needs OPENROUTER_API_KEY above. Without it the box does not render and the
# reason is on /admin -- the pages themselves are unaffected.
#
# NEVER point LLM_ASK_MODEL at a ":free" variant. They are delisted without
# notice and capped around 200 requests a day; the id is rejected at startup.
#
# The endpoint is public and the key sits behind it, so all three caps are
# enforced against the persisted llm_usage table (they survive a restart) and
# checked before the upstream call. Failed calls count.
# ---------------------------------------------------------------------------
LLM_ASK_MODEL=deepseek/deepseek-chat
LLM_ASK_PER_IP_PER_HOUR=10
LLM_ASK_PER_DAY=300
LLM_ASK_DAILY_COST_USD=1.0
LLM_ASK_MAX_TOKENS=220
LLM_ASK_MAX_QUESTION_CHARS=300
LLM_ASK_TIMEOUT_S=25

# ---------------------------------------------------------------------------
# Funnel widths
# ---------------------------------------------------------------------------
STAGE2_TAKE=400
STAGE3_TAKE=100
STAGE4_TAKE=25
STAGE5_TAKE=10
MAX_PER_SECTOR=3

# ---------------------------------------------------------------------------
# Universe filters
# ---------------------------------------------------------------------------
MIN_PRICE=3.0
MIN_DOLLAR_VOLUME=2000000
MIN_MARKET_CAP=150000000
# Abort the run rather than ship a report built on a broken universe.
MIN_UNIVERSE_SIZE=4000

# ---------------------------------------------------------------------------
# Paid API access (manual grants -- there is no payment processor)
# ---------------------------------------------------------------------------
# The shared secret for POST /admin/grant-access, which is the ONLY way to mark
# somebody as having paid. Generate one with:  openssl rand -hex 32
#
# LEAVING THIS UNSET DOES NOT OPEN THE ENDPOINT -- it disables it (503). That is
# deliberate: an empty secret compared against an empty header would match, so
# failing closed is the only safe reading of "not configured".
ADMIN_SECRET=

# Shown to buyers as the address to send payment and their API key to. Unset
# renders as "the site owner" rather than a broken mailto: link.
ADMIN_EMAIL=you@example.com

# Calls per calendar month by tier, and the prices quoted on /dashboard.
# Pro is a large ceiling rather than literally unlimited: a key that leaks
# should cost a bounded amount of database time.
FREE_TIER_MONTHLY_CALLS=10
PRO_TIER_MONTHLY_CALLS=10000
DATASET_PRICE_USD=29
PRO_PRICE_USD=49

# ---------------------------------------------------------------------------
# Outgoing mail -- key recovery only ("Resend my key" on /dashboard)
# ---------------------------------------------------------------------------
# Sent through AgentMail (https://agentmail.to) -- one HTTP call, no relay
# credentials to hold. Unset AGENTMAIL_API_KEY disables sending and the
# dashboard offers "contact the owner" instead; a recovery flow that quietly
# drops the message is worse than one that says it is off.
AGENTMAIL_API_KEY=
# Optional. Pins the mailbox to send from. Unset, the service creates one under
# a stable client_id and reuses it across restarts.
AGENTMAIL_INBOX_ID=
# NOTE: on the free plan mail goes out from an @agentmail.to address. This
# message carries an API key, so a custom domain is worth the paid plan --
# a credential arriving from an unfamiliar domain is a spam-folder candidate,
# and the whole point is that the person gets their key back.
RESEND_RATE_PER_HOUR=10
RESEND_COOLDOWN_S=600

# ---------------------------------------------------------------------------
# Public demo (the live API box on the home page)
# ---------------------------------------------------------------------------
# A REAL key, used server-side only -- it is never sent to the browser, and the
# demo account is barred from /api/company so a leak buys nothing. Unset simply
# turns the demo off. Generate with: openssl rand -hex 32
DEMO_API_KEY=
DEMO_CALLS_PER_IP_PER_DAY=5

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO

# Deprecated / unused. The /run and /backfill endpoints are open by design so
# the one-button site needs no token. You can leave this unset and delete it.
API_KEY=
RUN_TIMEZONE=America/New_York
RUN_HOUR=6
RUN_MINUTE=0

# Single-service mode: set true on the one Railway service so it runs the daily
# funnel cron inside the API process (no separate worker). Leave unset locally.
ENABLE_SCHEDULER=false
REPORT_DIR=/data/reports
MAX_RUN_COST_USD=2.0
HTTP_CONCURRENCY=10

# Business days added on top of filing_date to model ingestion lag.
PIT_LAG_BUSINESS_DAYS=2
