<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ticker }} — Alpha Funnel detail</title>
{% if needs_plotly %}<script>{{ plotly_js|safe }}</script>{% endif %}
<style>
:root{
  --bg:#080b11;--panel:#111722;--panel2:#171f2b;--line:#232c38;
  --fg:#e8eef5;--muted:#8a95a5;--dim:#616c7d;
  --up:#41c164;--down:#f85149;--accent:#5b9dff;--warn:#e3b341;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,"JetBrains Mono",Consolas,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(1200px 600px at 80% -20%,#1d3a8a20,transparent),var(--bg);
color:var(--fg);font:15px/1.65 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.wrap{max-width:1060px;margin:0 auto;padding:0 20px}
.top{position:sticky;top:0;background:#080b11e0;backdrop-filter:blur(12px);border-bottom:1px solid var(--line);z-index:5}
.top .wrap{display:flex;align-items:center;gap:16px;height:56px}
.back{color:var(--muted);font-size:14px}
.top .sp{flex:1}

header.hero{padding:34px 0 20px}
.sym{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.sym h1{font-family:var(--mono);font-size:38px;letter-spacing:.01em;margin:0}
.px{font-family:var(--mono);font-size:20px}
.px .chg.up{color:var(--up)}.px .chg.down{color:var(--down)}
.sub{color:var(--muted);font-size:14px;margin-top:6px}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.badge{font-size:12px;padding:4px 11px;border-radius:99px;background:var(--panel2);border:1px solid var(--line);color:var(--muted)}
.badge.hi{color:var(--up);border-color:#238636}.badge.med{color:var(--warn);border-color:#8a6d1f}
.scorebadge{font-family:var(--mono);font-weight:700}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:8px 0 26px}
@media(max-width:820px){.grid{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;overflow:hidden}
.card.full{grid-column:1/-1}
.card h3{margin:0 0 12px;font-size:14px;letter-spacing:.02em;color:var(--muted);text-transform:uppercase}
.card img,.card .plotly-graph-div{max-width:100%;border-radius:8px}
.chartwrap{overflow-x:auto}

.thesis{font-size:15.5px;color:#d4dde8;margin:0 0 14px}
.case{border-left:3px solid var(--line);padding:10px 0 10px 13px;margin:12px 0;font-size:14px}
.case.bull{border-color:var(--up)}.case.bear{border-color:var(--down)}
.case.inval{border-color:var(--warn);background:#e3b3410f;border-radius:0 8px 8px 0;padding:11px 13px}
.case b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:3px}
ul.clean{margin:8px 0 0;padding-left:18px;color:var(--muted);font-size:14px}
ul.clean li{margin:3px 0}

.subs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.subs .c{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:9px 11px}
.subs .c b{font-family:var(--mono);font-size:18px}
.subs .c span{display:block;color:var(--dim);font-size:10px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px}

table.health{width:100%;border-collapse:collapse;font-size:13.5px}
table.health td{padding:9px 6px;border-bottom:1px solid var(--line)}
table.health td.k{color:var(--muted)}
table.health td.v{text-align:right;font-family:var(--mono);color:var(--fg)}
table.health td.h{color:var(--dim);font-size:11px;text-align:right;width:1%;white-space:nowrap;padding-left:16px}

.note{background:var(--panel);border:1px dashed var(--line);border-radius:12px;padding:18px;color:var(--muted);font-size:14px}
footer{border-top:1px solid var(--line);padding:22px 0 60px;color:var(--dim);font-size:12px;line-height:1.7}
</style>
</head>
<body>

<div class="top"><div class="wrap">
  <a class="back" href="/">← Alpha Funnel</a>
  <span class="sp"></span>
  <span class="sub" style="margin:0">as of {{ as_of }}</span>
</div></div>

<header class="hero"><div class="wrap">
  <div class="sym">
    <h1>{{ ticker }}</h1>
    {% if price is not none %}
    <span class="px">${{ '%.2f'|format(price) }}
      {% if change is not none %}<span class="chg {{ 'up' if change >= 0 else 'down' }}">{{ '%+.2f'|format(change) }}%</span>{% endif %}
    </span>{% endif %}
  </div>
  {% if name %}<div class="sub">{{ name }} · {{ sector }}</div>{% else %}<div class="sub">{{ sector }}</div>{% endif %}
  <div class="badges">
    {% if total_score is not none %}<span class="badge scorebadge" style="color:{{ '#41c164' if total_score>=75 else '#e3b341' if total_score>=60 else '#8a95a5' }}">{{ total_score }}/100</span>{% endif %}
    {% if rank %}<span class="badge">rank #{{ rank }}</span>{% endif %}
    {% if conviction %}<span class="badge {{ 'hi' if conviction=='high' else 'med' if conviction=='medium' else '' }}">{{ conviction }} conviction</span>{% endif %}
    {% if time_horizon_days %}<span class="badge">{{ time_horizon_days }}d horizon</span>{% endif %}
    {% if stage_reached %}<span class="badge">reached stage {{ stage_reached }}</span>{% endif %}
  </div>
</div></header>

<main class="wrap">

{% if not has_thesis %}
  <div class="note">{{ ticker }} isn't in the latest top-10 screen, so there's no written thesis for it.
  Below is whatever the funnel has stored — price history and, if available, fundamentals.</div>
{% endif %}

<div class="grid">
  {% if charts.price.img or charts.price.html %}
  <div class="card full">
    <h3>Price, moving averages &amp; notable events</h3>
    <div class="chartwrap">{{ render_chart(charts.price) }}</div>
  </div>
  {% endif %}

  {% if has_thesis %}
  <div class="card">
    <h3>The thesis</h3>
    <p class="thesis">{{ thesis }}</p>
    {% if bull_case %}<div class="case bull"><b>Bull case</b>{{ bull_case }}</div>{% endif %}
    {% if bear_case %}<div class="case bear"><b>Bear case</b>{{ bear_case }}</div>{% endif %}
    {% if invalidation %}<div class="case inval"><b>Invalidation — throw the idea out if…</b>{{ invalidation }}</div>{% endif %}
    {% if key_risks %}<div style="margin-top:12px"><b style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)">Key risks</b>
      <ul class="clean">{% for r in key_risks %}<li>{{ r }}</li>{% endfor %}</ul></div>{% endif %}
    {% if catalysts_ahead %}<div style="margin-top:12px"><b style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)">Catalysts ahead</b>
      <ul class="clean">{% for c in catalysts_ahead %}<li>{{ c.event }}{% if c.date %} <span style="color:var(--dim)">({{ c.date }})</span>{% endif %}</li>{% endfor %}</ul></div>{% endif %}
  </div>
  {% endif %}

  {% if subscores %}
  <div class="card">
    <h3>Score breakdown</h3>
    <div class="subs">
      {% for k in rubric %}
      <div class="c"><b>{{ subscores.get(k, '—') }}</b><span>{{ k }}</span></div>
      {% endfor %}
    </div>
    {% if charts.radar.img or charts.radar.html %}<div class="chartwrap" style="margin-top:12px">{{ render_chart(charts.radar) }}</div>{% endif %}
  </div>
  {% endif %}

  {% if health %}
  <div class="card">
    <h3>Company health</h3>
    <table class="health">
      {% for row in health %}
      <tr><td class="k">{{ row.label }}</td><td class="v">{{ row.value }}</td><td class="h">{{ row.hint }}</td></tr>
      {% endfor %}
    </table>
    {% if news_tone is not none %}<div class="sub" style="margin-top:12px">Recent news tone {{ '%+.2f'|format(news_tone) }}{% if news_volume %} across {{ news_volume|int }} articles{% endif %}.</div>{% endif %}
  </div>
  {% endif %}

  {% if charts.fundamentals.img or charts.fundamentals.html %}
  <div class="card">
    <h3>Fundamentals — 8 quarters</h3>
    <div class="chartwrap">{{ render_chart(charts.fundamentals) }}</div>
  </div>
  {% endif %}

  {% if charts.peers.img or charts.peers.html %}
  <div class="card">
    <h3>Versus sector peers</h3>
    <div class="chartwrap">{{ render_chart(charts.peers) }}</div>
  </div>
  {% endif %}
</div>

</main>

<footer><div class="wrap">
  Research and idea-generation only. Charts from stored funnel data. The score is a heuristic pipeline plus a
  language model's interpretation, not a prediction — every thesis ships with an explicit invalidation condition.
  <b>Nothing here is investment advice.</b> &nbsp;·&nbsp; <a href="/report/{{ as_of }}/html">full daily report</a>
</div></footer>

</body>
</html>
