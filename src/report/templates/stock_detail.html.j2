<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ticker }} — Alpha Funnel detail</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
{% if needs_plotly %}<script>{{ plotly_js|safe }}</script>{% endif %}
<style>
:root{
  --paper:#F3EFE4;--paper2:#EAE3D3;--card:#FBFAF4;
  --ink:#161310;--ink2:#544c40;--dim:#8b8272;
  --red:#E1362C;--blue:#2340BE;--yellow:#F3C218;
  --disp:"Jost",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"Space Mono",ui-monospace,Menlo,Consolas,monospace;
  --sh:4px 4px 0 var(--ink);
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 var(--disp);
-webkit-font-smoothing:antialiased;color-scheme:light}
a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}
h1,h2,h3{font-weight:800;letter-spacing:-.01em;margin:0}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.top{position:sticky;top:0;background:var(--paper);border-bottom:2px solid var(--ink);z-index:5}
.top .wrap{display:flex;align-items:center;gap:16px;height:58px}
.back{color:var(--ink);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.04em;border-bottom:2px solid var(--ink);padding-bottom:2px}
.back:hover{text-decoration:none;color:var(--blue);border-color:var(--blue)}
.top .sp{flex:1}
.top .sub{font-family:var(--mono);font-size:12px;color:var(--ink2)}

header.hero{padding:34px 0 22px}
.sym{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
.sym h1{font-family:var(--mono);font-size:44px;font-weight:700;letter-spacing:.01em}
.px{font-family:var(--mono);font-size:20px;font-weight:700}
.px .chg.up{color:var(--blue)}.px .chg.down{color:var(--red)}
.sub{color:var(--ink2);font-size:14px;margin-top:8px}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.badge{font-family:var(--mono);font-size:12px;font-weight:700;padding:5px 11px;border:2px solid var(--ink);
  background:var(--card);text-transform:uppercase;letter-spacing:.03em}
.badge.hi{background:var(--blue);color:var(--paper)}.badge.med{background:var(--yellow);color:var(--ink)}
.scorebadge{font-family:var(--mono);font-weight:700}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:10px 0 30px}
@media(max-width:820px){.grid{grid-template-columns:1fr}}
.card{background:var(--card);border:2px solid var(--ink);box-shadow:var(--sh);padding:20px;overflow:hidden}
.card.full{grid-column:1/-1}
.card h3{margin:0 0 14px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;
  padding-bottom:10px;border-bottom:2px solid var(--ink)}
.card img,.card .plotly-graph-div{max-width:100%}
.chartwrap{overflow-x:auto}

.thesis{font-size:15.5px;color:var(--ink);margin:0 0 14px;line-height:1.5}
.case{border-left:4px solid var(--ink);padding:2px 0 2px 14px;margin:13px 0;font-size:14px;line-height:1.45}
.case.bull{border-color:var(--blue)}.case.bear{border-color:var(--red)}
.case.inval{border-color:var(--yellow);background:#f3c2181f;padding:11px 14px}
.case b{display:block;font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink2);margin-bottom:3px;font-weight:700}
ul.clean{margin:8px 0 0;padding-left:18px;color:var(--ink2);font-size:14px}
ul.clean li{margin:3px 0}

.subs{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:2px solid var(--ink);background:var(--ink)}
.subs .c{background:var(--card);padding:10px 12px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink)}
.subs .c b{font-family:var(--mono);font-size:19px;font-weight:700}
.subs .c span{display:block;color:var(--dim);font-size:9px;text-transform:uppercase;letter-spacing:.06em;margin-top:2px;font-weight:600}

table.health{width:100%;border-collapse:collapse;font-size:13.5px}
table.health td{padding:9px 4px;border-bottom:2px solid var(--paper2)}
table.health td.k{color:var(--ink2)}
table.health td.v{text-align:right;font-family:var(--mono);font-weight:700;color:var(--ink)}
table.health td.h{color:var(--dim);font-size:11px;text-align:right;width:1%;white-space:nowrap;padding-left:16px;font-family:var(--mono)}

.note{background:var(--card);border:2px dashed var(--ink);padding:20px;color:var(--ink2);font-size:14px}
footer{border-top:2px solid var(--ink);padding:24px 0 60px;color:var(--ink2);font-size:12px;line-height:1.7}
footer b{color:var(--ink)}
</style>
</head>
<body>

<div class="top"><div class="wrap">
  <a class="back" href="/">← Alpha Funnel</a>
  <span class="sp"></span>
  <span class="sub" style="margin:0">as of {{ as_of }}</span>
</div></div>

<header class="hero"><div class="wrap">
  <div class="sym">
    <h1>{{ ticker }}</h1>
    {% if price is not none %}
    <span class="px">${{ '%.2f'|format(price) }}
      {% if change is not none %}<span class="chg {{ 'up' if change >= 0 else 'down' }}">{{ '%+.2f'|format(change) }}%</span>{% endif %}
    </span>{% endif %}
  </div>
  {% if name %}<div class="sub">{{ name }} · {{ sector }}</div>{% else %}<div class="sub">{{ sector }}</div>{% endif %}
  <div class="badges">
    {% if total_score is not none %}<span class="badge scorebadge" style="color:{{ '#41c164' if total_score>=75 else '#e3b341' if total_score>=60 else '#8a95a5' }}">{{ total_score }}/100</span>{% endif %}
    {% if rank %}<span class="badge">rank #{{ rank }}</span>{% endif %}
    {% if conviction %}<span class="badge {{ 'hi' if conviction=='high' else 'med' if conviction=='medium' else '' }}">{{ conviction }} conviction</span>{% endif %}
    {% if time_horizon_days %}<span class="badge">{{ time_horizon_days }}d horizon</span>{% endif %}
    {% if stage_reached %}<span class="badge">reached stage {{ stage_reached }}</span>{% endif %}
  </div>
</div></header>

<main class="wrap">

{% if not has_thesis %}
  <div class="note">{{ ticker }} isn't in the latest top-10 screen, so there's no written thesis for it.
  Below is whatever the funnel has stored — price history and, if available, fundamentals.</div>
{% endif %}

<div class="grid">
  {% if charts.price.img or charts.price.html %}
  <div class="card full">
    <h3>Price, moving averages &amp; notable events</h3>
    <div class="chartwrap">{{ render_chart(charts.price) }}</div>
  </div>
  {% endif %}

  {% if has_thesis %}
  <div class="card">
    <h3>The thesis</h3>
    <p class="thesis">{{ thesis }}</p>
    {% if bull_case %}<div class="case bull"><b>Bull case</b>{{ bull_case }}</div>{% endif %}
    {% if bear_case %}<div class="case bear"><b>Bear case</b>{{ bear_case }}</div>{% endif %}
    {% if invalidation %}<div class="case inval"><b>Invalidation — throw the idea out if…</b>{{ invalidation }}</div>{% endif %}
    {% if key_risks %}<div style="margin-top:12px"><b style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)">Key risks</b>
      <ul class="clean">{% for r in key_risks %}<li>{{ r }}</li>{% endfor %}</ul></div>{% endif %}
    {% if catalysts_ahead %}<div style="margin-top:12px"><b style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)">Catalysts ahead</b>
      <ul class="clean">{% for c in catalysts_ahead %}<li>{{ c.event }}{% if c.date %} <span style="color:var(--dim)">({{ c.date }})</span>{% endif %}</li>{% endfor %}</ul></div>{% endif %}
  </div>
  {% endif %}

  {% if subscores %}
  <div class="card">
    <h3>Score breakdown</h3>
    <div class="subs">
      {% for k in rubric %}
      <div class="c"><b>{{ subscores.get(k, '—') }}</b><span>{{ k }}</span></div>
      {% endfor %}
    </div>
    {% if charts.radar.img or charts.radar.html %}<div class="chartwrap" style="margin-top:12px">{{ render_chart(charts.radar) }}</div>{% endif %}
  </div>
  {% endif %}

  {% if health %}
  <div class="card">
    <h3>Company health</h3>
    <table class="health">
      {% for row in health %}
      <tr><td class="k">{{ row.label }}</td><td class="v">{{ row.value }}</td><td class="h">{{ row.hint }}</td></tr>
      {% endfor %}
    </table>
    {% if news_tone is not none %}<div class="sub" style="margin-top:12px">Recent news tone {{ '%+.2f'|format(news_tone) }}{% if news_volume %} across {{ news_volume|int }} articles{% endif %}.</div>{% endif %}
  </div>
  {% endif %}

  {% if charts.fundamentals.img or charts.fundamentals.html %}
  <div class="card">
    <h3>Fundamentals — 8 quarters</h3>
    <div class="chartwrap">{{ render_chart(charts.fundamentals) }}</div>
  </div>
  {% endif %}

  {% if charts.peers.img or charts.peers.html %}
  <div class="card">
    <h3>Versus sector peers</h3>
    <div class="chartwrap">{{ render_chart(charts.peers) }}</div>
  </div>
  {% endif %}
</div>

</main>

<footer><div class="wrap">
  Research and idea-generation only. Charts from stored funnel data. The score is a heuristic pipeline plus a
  language model's interpretation, not a prediction — every thesis ships with an explicit invalidation condition.
  <b>Nothing here is investment advice.</b> &nbsp;·&nbsp; <a href="/report/{{ as_of }}/html">full daily report</a>
</div></footer>

</body>
</html>
